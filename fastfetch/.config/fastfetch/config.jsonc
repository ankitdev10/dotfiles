{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#cba6f7",
      "2": "#cdd6f4",
      "3": "#fab387",
      "4": "#6c7086",
      "5": "#a6e3a1",
      "6": "#f5e0dc",
      "7": "#9399b2",
      "8": "#89b4fa",
      "9": "#45475a"
    },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#cba6f7", "title": "#a6e3a1" },
    "key": { "width": 4 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;69;71;90m──────────────────────────────" },
    { "type": "os", "key": "", "keyColor": "#89b4fa" },
    { "type": "kernel", "key": "", "keyColor": "#89b4fa" },
    { "type": "uptime", "key": "", "keyColor": "#94e2d5" },
    { "type": "packages", "key": "", "keyColor": "#94e2d5" },
    { "type": "wm", "key": "", "keyColor": "#cba6f7" },
    { "type": "terminal", "key": "", "keyColor": "#cba6f7" },
    { "type": "shell", "key": "", "keyColor": "#cba6f7" },
    { "type": "cpu", "key": "", "keyColor": "#fab387" },
    { "type": "gpu", "key": "", "keyColor": "#fab387" },
    { "type": "memory", "key": "\uefc5", "keyColor": "#f38ba8" },
    { "type": "disk", "key": "", "keyColor": "#f38ba8", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
