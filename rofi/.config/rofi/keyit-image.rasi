@import "keyit.rasi"

window {
    width: 700px;
}

mainbox {
    orientation: horizontal;
    children: [ imagebox, listbox ];
}

imagebox {
    expand: false;
    width: 210px;
    background-image: url("~/.config/rofi/images/panel.jpg", width);
    border-radius: 18px 0 0 18px;
}

listbox {
    orientation: vertical;
    children: [ inputbar, listview ];
    spacing: 0;
}
