@import "colors.rasi"

* {
    font: "FiraCode Nerd Font 11";
    background-color: @al;
    text-color: @fg;
}

window {
    transparency: "real";
    background-color: @bg;
    border: 2px;
    border-color: @br;
    border-radius: 0;
    border: 0;
    width: 100%;
    height: 100%;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0;
    padding: 0;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @ac;
    margin: 120px 30% 40px 30%;
    border-radius: 14px;
    padding: 18px 20px;
    spacing: 14px;
}

prompt {
    text-color: @hl;
    font: "FiraCode Nerd Font 13";
}

entry {
    placeholder: "Search";
    placeholder-color: @dim;
    cursor: text;
    blink: true;
}

message {
    background-color: @ac;
    padding: 0 20px 14px 20px;
}

textbox {
    text-color: @dim;
}

listview {
    columns: 5;
    lines: 6;
    fixed-height: false;
    dynamic: true;
    cycle: false;
    scrollbar: false;
    spacing: 0;
    padding: 0 12%;
    spacing: 10px;
}

element {
    orientation: vertical;
    border-radius: 14px;
    padding: 20px 10px;
    spacing: 14px;
    cursor: pointer;
}

element normal.normal, element alternate.normal {
    background-color: @al;
    text-color: @fg;
}

element selected.normal {
    background-color: @se;
    text-color: @fg;
}

element-icon {
    size: 64px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
