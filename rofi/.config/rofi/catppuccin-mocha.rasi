* {
    bg-col:        #1e1e2e;
    bg-col-light:  #313244;
    border-col:    #cba6f7;
    selected-col:  #313244;
    accent:        #cba6f7;
    fg-col:        #cdd6f4;
    fg-col2:       #f5c2e7;
    grey:          #6c7086;

    font: "FiraCode Nerd Font 12";
    background-color: transparent;
    text-color: @fg-col;
}

window {
    width: 600px;
    border: 2px;
    border-radius: 12px;
    border-color: @border-col;
    background-color: @bg-col;
    padding: 12px;
}

mainbox {
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 8px 12px;
    spacing: 10px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search";
    placeholder-color: @grey;
    cursor: text;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    spacing: 10px;
    cursor: pointer;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-col;
}

element selected.normal {
    background-color: @selected-col;
    text-color: @fg-col2;
}

element-icon {
    size: 22px;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}

message {
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 8px;
}
