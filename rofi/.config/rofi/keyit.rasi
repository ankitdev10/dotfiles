@import "colors.rasi"

* {
    font: "FiraCode Nerd Font 11";
    background-color: @al;
    text-color: @fg;
}

window {
    transparency: "real";
    background-color: @bg;
    border: 2px;
    border-color: @br;
    border-radius: 20px;
    width: 480px;
    location: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0;
    padding: 0;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @ac;
    padding: 18px 20px;
    spacing: 14px;
}

prompt {
    text-color: @hl;
    font: "FiraCode Nerd Font 13";
}

entry {
    placeholder: "Search";
    placeholder-color: @dim;
    cursor: text;
    blink: true;
}

message {
    background-color: @ac;
    padding: 0 20px 14px 20px;
}

textbox {
    text-color: @dim;
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: false;
    dynamic: true;
    cycle: false;
    scrollbar: false;
    spacing: 0;
    padding: 8px 0 12px 0;
}

element {
    orientation: horizontal;
    padding: 9px 20px;
    spacing: 14px;
    cursor: pointer;
}

element normal.normal, element alternate.normal {
    background-color: @al;
    text-color: @fg;
}

element selected.normal {
    background-color: @se;
    text-color: @fg;
}

element-icon {
    size: 26px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
